{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ileoja-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "project-images",
    },
  ],

  "env": {
    "staging": {
      "name": "ileoja-backend-staging",
      "r2_buckets": [
        {
          "binding": "PRODUCT_IMAGES",
          "bucket_name": "project-images",
        },
      ],
    },
    "production": {
      "name": "ileoja-backend",
      "r2_buckets": [
        {
          "binding": "PRODUCT_IMAGES",
          "bucket_name": "project-images",
        },
      ],
    },
  },
}
